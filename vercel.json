{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {"source": "/robots.txt", "destination": "/api/robots"},
    {"source": "/sitemap.xml", "destination": "/api/sitemap"},
    {"source": "/assets/:path*", "destination": "/assets/:path*"},
    {"source": "/(.*)", "destination": "/index.html"}
  ]
}
